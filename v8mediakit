<script>
/* ── PLAIN-TEXT CLIPBOARD FIX ── */
document.addEventListener('copy', function(e) {
  const sel = window.getSelection();
  if (!sel || sel.isCollapsed) return;
  e.clipboardData.setData('text/plain', sel.toString());
  e.clipboardData.setData('text/html', sel.toString());
  e.preventDefault();
});

/* ── TILE GEOMETRY ── */
const CW=345, CH=253, SHEAR=74, STEP_X=58, STEP_Y=48;

const HOME_CARDS=[
  {id:'images', label:'Imagery',   img:'data:image/png;base64,',  target:'images'},
  {id:'docs',   label:'Documents', img:'data:image/png;base64,', target:'docs'},
  {id:'videos', label:'Videos',    img:'data:image/png;base64,',     target:'videos'},
];
const IMAGE_CARDS=[
  {id:'sat',      label:'Satellites & manufacturing', img:'data:image/png;base64,', target:'gallery',gkey:'satellites',gtitle:'Satellites & manufacturing'},
  {id:'fac',      label:'Facility & infrastructure',  img:'data:image/png;base64,',  target:'gallery',gkey:'facility',  gtitle:'Facility & infrastructure'},
  {id:'founders', label:'Founders',                   img:'data:image/png;base64,', target:'gallery',gkey:'founders',  gtitle:'Founders'},
  {id:'aurora',   label:'Aurora platform',            img:'data:image/png;base64,',   target:'gallery',gkey:'aurora',    gtitle:'Aurora platform'},
  {id:'logos',    label:'Logo files',                 img:'data:image/png;base64,',     target:'gallery',gkey:'logos',     gtitle:'Logo files'},
];
const GALLERY={
  satellites:[['data:image/png;base64,','Firefly — Pixxel satellite'],['data:image/png;base64,','Firefly clean room integration'],['data:image/png;base64,','Shakuntala — 2nd generation'],['data:image/png;base64,','Antenna array detail']],
  facility:  [['data:image/png;base64,','Bangalore HQ exterior'],['data:image/png;base64,','Clean room assembly'],['data:image/png;base64,','Mission control'],['data:image/png;base64,','Optical lab']],
  founders:  [['data:image/png;base64,','Awais Ahmed — CEO'],['data:image/png;base64,','Kshitij Khandelwal — CTO'],['data:image/png;base64,','Founding team group photo']],
  aurora:    [['data:image/png;base64,','Aurora dashboard'],['data:image/png;base64,','Hyperspectral false colour'],['data:image/png;base64,','Agriculture analysis'],['data:image/png;base64,','Mineral detection map']],
  logos:     [['data:image/png;base64,','Pixxel logo — dark'],['data:image/png;base64,','Pixxel logo — light'],['data:image/png;base64,','Icon mark'],['data:image/png;base64,','GeoVault logo']],
};

function buildStack(sceneEl, cards, onClick) {
  sceneEl.innerHTML='';
  const n=cards.length;
  const totalW=CW+STEP_X*(n-1)+20;
  const totalH=CH+STEP_Y*(n-1)+SHEAR+20;
  sceneEl.style.width=totalW+'px';
  sceneEl.style.height=totalH+'px';
  const baseTop=totalH-CH-SHEAR-10;
  for(let i=n-1;i>=0;i--) {
    const c=cards[i];
    const el=document.createElement('div');
    el.className='iso-card';
    el.style.cssText=`left:${i*STEP_X}px;top:${baseTop-i*STEP_Y}px;width:${CW}px;height:${CH+SHEAR}px;z-index:${n-i};position:absolute;`;
    el.innerHTML=`<div class="card-shape" style="height:100%"><img src="${c.img}" alt="${c.label}" draggable="false"><div class="card-overlay"></div></div>`;
    el.addEventListener('click',()=>onClick(c));
    sceneEl.appendChild(el);
  }
}

/* ── NAV ── */
const PARENT={images:'home',gallery:'images',videos:'home',docs:'home',about:'home'};
const HEADINGS={home:'Media Kit',images:'Imagery',gallery:'',videos:'Videos',docs:'Documents',about:'About'};
const NAVMAP={home:'ni-home',images:'ni-images',gallery:'ni-images',videos:'ni-videos',docs:'ni-docs',about:'ni-about'};
const DL_SCREENS=new Set(['gallery']);
let current='home', transitioning=false;

function nav(id,gtitle,gkey) {
  if(id===current||transitioning) return;
  transitioning=true;
  if(id==='gallery'&&gkey) { HEADINGS.gallery=gtitle||''; buildGallery(gkey); }
  const fromEl=document.getElementById(current);
  const toEl=document.getElementById(id);
  if(!toEl){ transitioning=false; return; }
  fromEl.classList.add('exit');
  setTimeout(()=>{
    fromEl.classList.remove('visible','active','exit');
    current=id;
    toEl.classList.add('active');
    toEl.offsetHeight;
    requestAnimationFrame(()=>{ toEl.classList.add('visible'); transitioning=false; });
    applyScreenState(id);
  },380);
}

function applyScreenState(id) {
  document.getElementById('page-heading').textContent=HEADINGS[id]||'';
  Object.values(NAVMAP).forEach(n=>document.getElementById(n)?.classList.remove('active'));
  if(NAVMAP[id]) document.getElementById(NAVMAP[id]).classList.add('active');
  document.getElementById('content').classList.toggle('hl-spread',!['home','images'].includes(id));
  document.getElementById('dl-all-btn').classList.toggle('show',DL_SCREENS.has(id));
  if(id==='images') buildStack(document.getElementById('scene-images'),IMAGE_CARDS,c=>nav(c.target,c.gtitle,c.gkey));
  if(id==='videos') setTimeout(triggerVideos,100);
}

function goBack() { nav(PARENT[current]||'home'); }

/* ── GALLERY ── */
function buildGallery(key) {
  const items=GALLERY[key]||[];
  document.getElementById('gallery-grid').innerHTML=items.map(([src,cap])=>`
    <div class="img-card">
      <img class="img-thumb" src="${src}" alt="" onclick="openLB('${src}','${cap}')">
      <button class="img-dl-btn" onclick="dlImg('${src}','${cap}')" title="Download">
        <svg viewBox="0 0 16 16" fill="none">
          <path d="M8 2v8m0 0L5 7m3 3l3-3M2 13h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <p class="img-cap">${cap}</p>
    </div>`).join('');
}

function dlImg(src, name) {
  const a=document.createElement('a');
  a.href=src; a.download=name+'.png'; a.click();
}

/* ── VIDEO SCROLL ── */
function triggerVideos() {
  const wrap=document.getElementById('videos-wrap');
  const items=document.querySelectorAll('.video-item');
  const obs=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('in');})
    ,{threshold:0.1,root:wrap});
  items.forEach(i=>{i.classList.remove('in');obs.observe(i);});
  setTimeout(()=>{items.forEach(i=>i.classList.add('in'));},80);
}

/* ── LIGHTBOX ── */
function openLB(src,cap) {
  document.getElementById('lb-img').src=src;
  document.getElementById('lb-cap').textContent=cap;
  document.getElementById('lightbox').classList.add('open');
}
function closeLB() {
  document.getElementById('lightbox').classList.remove('open');
  setTimeout(()=>document.getElementById('lb-img').src='',350);
}
document.getElementById('lightbox').addEventListener('click',e=>{
  if(e.target===document.getElementById('lightbox'))closeLB();
});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeLB();});

/* ── TRACKPAD SWIPE RIGHT = BACK ── */
let swipeTimer=null;
document.addEventListener('wheel',e=>{
  if(Math.abs(e.deltaX)<Math.abs(e.deltaY)*0.7||swipeTimer) return;
  swipeTimer=setTimeout(()=>swipeTimer=null,700);
  if(e.deltaX<-50&&current!=='home') goBack();
},{passive:true});

/* ── TOP NAV HIDE ON SCROLL ── */
let lastScrollY=0;
document.querySelectorAll('.inner-wrap').forEach(wrap=>{
  wrap.addEventListener('scroll',()=>{
    if(['home','images'].includes(current)) return;
    const y=wrap.scrollTop, tn=document.getElementById('top-nav');
    if(y>lastScrollY&&y>40) tn.classList.add('hide-nav');
    else tn.classList.remove('hide-nav');
    lastScrollY=y;
  });
});

/* ── INIT ── */
(function(){
  buildStack(document.getElementById('scene-home'),HOME_CARDS,c=>nav(c.target));
  const home=document.getElementById('home');
  home.classList.add('active');
  requestAnimationFrame(()=>home.classList.add('visible'));
  document.getElementById('ni-home').classList.add('active');
})();
</script>
