<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pixxel — Media Kit</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500&family=Barlow:wght@300;400&display=swap" rel="stylesheet">
<style>
@font-face{font-family:'NewBlack';src:url('data:font/opentype;base64,') format('opentype');font-weight:300;font-style:normal;}
@font-face{font-family:'NewBlack';src:url('data:font/opentype;base64,') format('opentype');font-weight:400;font-style:normal;}
@font-face{font-family:'NewBlack';src:url('data:font/opentype;base64,') format('opentype');font-weight:500;font-style:normal;}
@font-face{font-family:'NewBlack';src:url('data:font/opentype;base64,') format('opentype');font-weight:700;font-style:normal;}


:root {
  --bg:       #0A0A0A;
  --nav:      #0F0F0F;
  --line:     #2a2a2a;
  --text:     #F0EEEB;
  --text-off: rgba(240,238,235,0.38);
  --text-mid: rgba(240,238,235,0.60);
  --blue:     #00C8FF;
  --vid-tag:  #24526E;
  --top-h:    215px;
  --side-w:   168px;
  --pad:      86px;
}

*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }
html,body{
  height:100%; overflow:hidden;
  background:var(--bg); color:var(--text);
  font-family:'Inter',sans-serif;
  font-size:17px; /* base +10% from 15px */
}

/* ══ SHELL ══ */
#shell{
  display:grid;
  grid-template-columns: var(--side-w) 1fr;
  height:100vh; width:100%;
}
#main-col{
  display:grid;
  grid-template-rows: var(--top-h) 1fr;
  height:100vh; min-width:0;
}

/* ══ SIDEBAR ══ */
#sidebar{
  background:rgba(15,15,15,0.92);
  border-right:1px solid var(--line);
  display:flex; flex-direction:column;
  padding:36px 24px 28px;
  position:relative; z-index:200;
}
.sidebar-logo{
  height:20px; width:auto; display:block;
  object-fit:contain; object-position:left center;
  cursor:pointer; margin-bottom:6px;
}
.sidebar-sub{
  font-family:'Barlow',sans-serif;
  font-size:0.6rem; letter-spacing:0.16em; text-transform:uppercase;
  color:var(--text-off); margin-bottom:32px;
}
.nav-items{ display:flex; flex-direction:column; gap:2px; }
.nav-item{
  background:none; border:none; cursor:pointer;
  font-family:'Barlow',sans-serif;
  font-size:0.73rem; letter-spacing:0.1em; text-transform:uppercase;
  color:var(--text-off); padding:6px 0; text-align:left;
  transition:color 0.2s;
}
.nav-item:hover{ color:var(--text); }
.nav-item.active{ color:var(--text); font-weight:500; }

/* ══ TOP NAV ══ */
#top-nav{
  background:var(--nav);
  border-bottom:1px solid var(--line);
  display:flex; align-items:center; justify-content:space-between;
  padding:0 var(--pad);
  position:relative; z-index:150;
  transition:transform 0.4s cubic-bezier(0.4,0,0.2,1), opacity 0.4s ease;
}
#top-nav.hide-nav{ transform:translateY(-100%); opacity:0; pointer-events:none; }
.page-heading{
  font-family:'NewBlack','Inter',sans-serif; font-weight:400;
  font-size:clamp(1.54rem,2.86vw,2.09rem);
  letter-spacing:0.13em; text-transform:uppercase;
  color:var(--text); line-height:1;
}
.download-all-btn{
  font-family:'Barlow',sans-serif; font-size:0.68rem;
  letter-spacing:0.14em; text-transform:uppercase;
  color:var(--text-mid); background:none; border:1px solid var(--line);
  padding:9px 18px; cursor:pointer;
  transition:color 0.2s,border-color 0.2s,background 0.2s;
  display:none; align-items:center; gap:8px; white-space:nowrap;
}
.download-all-btn.show{ display:inline-flex; }
.download-all-btn:hover{ color:var(--text); border-color:var(--text-off); background:rgba(240,238,235,0.04); }
.download-all-btn svg{ width:12px; height:12px; }

/* ══ CONTENT ══ */
#content{ position:relative; overflow:hidden; }
#col-lines{ position:absolute; inset:0; pointer-events:none; z-index:5; }
.col-line{
  position:absolute; top:0; bottom:0; width:1px; background:var(--line);
  transition: left 0.85s cubic-bezier(0.77,0,0.175,1), right 0.85s cubic-bezier(0.77,0,0.175,1);
}
#hl-l{ left:299px; }
#hl-r{ right:320px; left:auto; }
.hl-spread #hl-l{ left:28px; }
.hl-spread #hl-r{ right:28px; left:auto; }

/* ══ SCREEN TRANSITIONS ══ */
.screen{
  position:absolute; inset:0;
  display:none; opacity:0;
  transition: opacity 0.4s ease, transform 0.4s ease;
  transform:scale(1); z-index:2;
}
.screen.active{ display:flex; flex-direction:column; }
.screen.visible{ opacity:1; transform:scale(1); }
.screen.exit{ opacity:0; transform:scale(0.94); pointer-events:none; }

/* ══ CLIPBOARD — plain text only on copy ══ */
/* No CSS needed; handled in JS */

/* ══ ISO TILE STACK ══ */
#home, #images{ align-items:center; justify-content:center; }
.stack-scene{ position:relative; flex-shrink:0; }
.iso-card{ position:absolute; cursor:pointer; }
.card-shape{
  width:100%; height:100%;
  clip-path:polygon(0% 0%, 100% 28.75%, 100% 100%, 0% 71.25%);
  overflow:hidden; position:relative;
}
.card-shape img{
  position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
  filter:brightness(0.78); transition:filter 0.3s; pointer-events:none;
  transform:scaleX(1.04); transform-origin:center;
}
.card-overlay{
  position:absolute; inset:0;
  background:linear-gradient(200deg,rgba(0,0,0,0) 40%,rgba(0,0,0,0.32) 100%);
  pointer-events:none;
}

/* ══ INNER WRAP ══ */
.inner-wrap{
  padding:36px var(--pad) 32px;
  overflow-y:auto; flex:1; min-height:0;
  scrollbar-width:thin; scrollbar-color:var(--line) transparent;
}

/* ══ IMAGE GALLERY — 4 columns with per-image download ══ */
.img-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
.img-card{ cursor:pointer; overflow:hidden; position:relative; }
.img-card:hover .img-dl-btn{ opacity:1; }
.img-thumb{
  width:100%; aspect-ratio:16/9; object-fit:cover; display:block;
  filter:brightness(0.82); transition:filter 0.3s;
}
.img-card:hover .img-thumb{ filter:brightness(1.05); }
.img-dl-btn{
  position:absolute; top:8px; right:8px;
  width:28px; height:28px;
  background:rgba(10,10,10,0.7); border:1px solid rgba(240,238,235,0.2);
  border-radius:50%; display:flex; align-items:center; justify-content:center;
  cursor:pointer; opacity:0; transition:opacity 0.2s,background 0.2s;
  color:var(--text);
}
.img-dl-btn:hover{ background:rgba(10,10,10,0.95); border-color:var(--text-off); }
.img-dl-btn svg{ width:13px; height:13px; pointer-events:none; }
.img-cap{
  font-family:'Barlow',sans-serif; font-size:0.79rem;
  color:var(--text); margin-top:8px; margin-bottom:20px;
}

/* ══ LIGHTBOX ══ */
#lightbox{
  position:fixed; inset:0; z-index:9000;
  background:rgba(10,10,10,0.96);
  display:flex; align-items:center; justify-content:center; flex-direction:column;
  opacity:0; pointer-events:none; transition:opacity 0.35s ease;
}
#lightbox.open{ opacity:1; pointer-events:auto; }
#lb-img{ max-width:88vw; max-height:80vh; object-fit:contain; transform:scale(0.95); transition:transform 0.35s ease; }
#lightbox.open #lb-img{ transform:scale(1); }
#lb-cap{ font-family:'Barlow',sans-serif; font-size:0.75rem; letter-spacing:0.08em; color:var(--text); margin-top:14px; }
#lb-close{
  position:fixed; top:24px; right:36px; background:none; border:none;
  color:var(--text-off); font-size:1.98rem; cursor:pointer;
  transition:color 0.2s; font-family:'Inter',sans-serif;
}
#lb-close:hover{ color:var(--text); }

/* ══ VIDEO FEED — 2-col grid ══ */
.video-feed{ display:grid; grid-template-columns:1fr 1fr; gap:24px 20px; }
.video-item{ opacity:0; transform:translateY(14px); transition:opacity 0.5s ease,transform 0.5s ease; }
.video-item.in{ opacity:1; transform:none; }
.video-frame{ width:100%; aspect-ratio:16/9; position:relative; overflow:hidden; background:#111; margin-bottom:12px; cursor:pointer; }
.video-frame img{ width:100%; height:100%; object-fit:cover; filter:brightness(0.78); transition:filter 0.3s; }
.video-frame:hover img{ filter:brightness(0.6); }
.play-btn{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
.play-btn svg{ width:40px; height:40px; opacity:0.7; transition:opacity 0.2s; }
.video-frame:hover .play-btn svg{ opacity:1; }
.video-meta{ display:flex; gap:8px; margin-bottom:7px; }
.vtag{
  font-family:'Barlow',sans-serif; font-size:0.64rem;
  letter-spacing:0.14em; text-transform:uppercase;
  color:#fff; background:var(--vid-tag); padding:3px 9px; display:inline-block;
}
.vtitle{
  font-family:'NewBlack','Inter',sans-serif; font-weight:400;
  font-size:1.01rem; color:var(--text); letter-spacing:0.02em; margin-bottom:5px;
}
.vdesc{ font-family:'Barlow',sans-serif; font-size:0.77rem; color:var(--text-mid); line-height:1.6; }

/* ══ DOC GRID ══ */
.doc-grid{ display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.doc-card{ background:#141414; cursor:pointer; border:1px solid var(--line); overflow:hidden; transition:border-color 0.2s; }
.doc-card:hover{ border-color:rgba(240,238,235,0.2); }
.doc-thumb{ width:100%; aspect-ratio:16/9; overflow:hidden; position:relative; }
.doc-thumb img{ width:100%; height:100%; object-fit:cover; filter:brightness(0.78); transition:filter 0.3s; }
.doc-card:hover .doc-thumb img{ filter:brightness(0.92); }
.doc-badge{ position:absolute; bottom:10px; right:12px; font-family:'Barlow',sans-serif; font-size:0.62rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(240,238,235,0.5); background:rgba(0,0,0,0.55); padding:2px 7px; }
.doc-body{ padding:14px 16px 18px; }
.doc-name{ font-family:'NewBlack','Inter',sans-serif; font-weight:400; font-size:0.97rem; color:var(--text); letter-spacing:0.04em; margin-bottom:6px; }
.doc-desc{ font-family:'Barlow',sans-serif; font-size:0.77rem; color:var(--text-mid); line-height:1.6; margin-bottom:10px; }
.doc-link{ font-family:'Barlow',sans-serif; font-size:0.68rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--blue); text-decoration:none; border-bottom:1px solid transparent; transition:border-color 0.2s; }
.doc-link:hover{ border-color:var(--blue); }

/* ══ ABOUT ══ */
#about{ position:relative; }
#about::before{
  content:''; position:absolute; inset:0;
  background:url('data:image/png;base64,') center/cover no-repeat;
  opacity:0.35; z-index:0;
}
#about .inner-wrap{ position:relative; z-index:1; display:flex; align-items:center; overflow:hidden; padding-top:36px; }
.about-body-text{ font-family:'Barlow',sans-serif; font-size:0.99rem; color:var(--text); line-height:1.8; margin-bottom:40px; max-width:520px; }
.about-grid{ display:grid; grid-template-columns:1fr 1fr; gap:20px 48px; margin-bottom:40px; }
.about-lbl{ font-family:'Barlow',sans-serif; font-size:0.64rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(240,238,235,0.35); margin-bottom:3px; }
.about-val{ font-family:'Inter',sans-serif; font-size:0.9rem; color:var(--text); }
.about-links{ display:flex; gap:24px; flex-wrap:wrap; }
.about-link{ font-family:'Barlow',sans-serif; font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase; color:rgba(240,238,235,0.62); text-decoration:none; border-bottom:1px solid rgba(240,238,235,0.2); padding-bottom:2px; transition:color 0.2s,border-color 0.2s; }
.about-link:hover{ color:var(--text); border-color:var(--text-off); }
</style>
</head>
